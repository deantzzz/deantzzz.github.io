---
import Arrow from './Arrow.astro';
import { getPublishedPosts, postUrl, formatDate } from '../lib/posts';
const posts = await getPublishedPosts();
---
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="search-heading"><h2 id="search-title">搜索文章</h2><button class="search-close" type="button" aria-label="关闭搜索">ESC <span aria-hidden="true">×</span></button></div>
  <label class="sr-only" for="search-input">标题、摘要或标签</label>
  <input id="search-input" type="search" placeholder="输入标题、摘要或标签…" maxlength="100" autocomplete="off" />
  <p class="search-count" role="status" aria-live="polite">{posts.length} 篇文章</p>
  <div class="search-results">
    {posts.map((post) => <a class="search-result" href={postUrl(post)} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`}><div><span>{post.data.title}</span><p>{post.data.description}</p><small>{formatDate(post.data.publishedAt)} · {post.data.tags.join(' / ')}</small></div><Arrow /></a>)}
  </div>
  <p class="search-empty" hidden>没有找到相关文章，试试其他关键词。</p>
  <div class="search-help"><span><kbd>↵</kbd> 打开文章</span><span><kbd>ESC</kbd> 返回</span></div>
</dialog>
