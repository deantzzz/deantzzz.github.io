---
import { SITE } from '../config';
const path = Astro.url.pathname;
const links = [
  { href: '/', text: '文章', active: path === '/' || path.startsWith('/posts/') || path.startsWith('/tags/') },
  { href: '/archive/', text: '归档', active: path.startsWith('/archive/') },
  { href: '/about/', text: '关于', active: path.startsWith('/about/') },
];
---
<header class="site-header">
  <div class="header-inner content">
    <a class="wordmark" href="/" aria-label={`${SITE.name} 首页`}><span aria-hidden="true">/</span> {SITE.name}</a>
    <nav aria-label="主导航">
      {links.map((link) => <a class:list={['nav-link', { active: link.active }]} href={link.href} aria-current={link.active ? 'page' : undefined}>{link.text}</a>)}
    </nav>
    <button class="search-toggle" type="button" aria-label="搜索文章" aria-haspopup="dialog" aria-controls="search-dialog" title="搜索文章（⌘ / Ctrl K）">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5" /><path d="m16 16 5 5" /></svg>
      <kbd aria-hidden="true">⌘ K</kbd>
    </button>
  </div>
</header>
