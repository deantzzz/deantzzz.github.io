---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
interface Props { tag: string; posts: Post[] }
const { tag, posts } = Astro.props;
---
<Base title={tag} description={`deantzzz 关于「${tag}」的文章。`}>
  <div class="page content">
    <header class="page-heading"><h1>{tag}</h1><p>写在同一个主题下的片段。</p></header>
    {posts.map((post) => <PostRow post={post} heading="h2" />)}
  </div>
</Base>
