---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPublishedPosts, yearOf } from '../lib/posts';
const posts = await getPublishedPosts();
const years = [...new Set(posts.map((post) => yearOf(post.data.publishedAt)))];
---
<Base title="归档" description="按时间翻阅 deantzzz 的文章。">
  <div class="page content">
    <header class="page-heading"><h1>归档</h1><p>沿着时间，回看写下的片段。</p></header>
    {years.map((year) => <section class="archive-year" aria-label={`${year} 年的文章`}><h2>{year}</h2>{posts.filter((post) => yearOf(post.data.publishedAt) === year).map((post) => <PostRow post={post} />)}</section>)}
    {posts.length === 0 && <p class="empty-state">第一篇文章，正在路上。</p>}
  </div>
</Base>
