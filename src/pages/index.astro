---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PostRow from '../components/PostRow.astro';
import mountains from '../assets/mountains.png';
import { SITE } from '../config';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
---
<Base>
  <section class="intro content" aria-labelledby="blog-title">
    <h1 id="blog-title">{SITE.name}</h1>
    <p class="tagline">{SITE.tagline}</p>
    <p class="intro-description">{SITE.description}</p>
    <a class="text-link intro-link" href="#articles">阅读文章 <Arrow /></a>
  </section>
  <div class="panorama wide">
    <Image src={mountains} alt="薄雾轻轻绕过层叠的山峦" widths={[640, 1200, 2172]} sizes="(max-width: 700px) calc(100vw - 40px), 90vw" format="webp" loading="eager" fetchpriority="high" />
  </div>
  <section id="articles" class="latest content" aria-labelledby="latest-title">
    <div class="section-heading">
      <h2 id="latest-title">最新文章</h2>
      <a class="text-link" href="/archive/">全部文章 <Arrow /></a>
    </div>
    {posts.slice(0, 5).map((post) => <PostRow post={post} />)}
    {posts.length === 0 && <p class="empty-state">第一篇文章，正在路上。</p>}
  </section>
</Base>
