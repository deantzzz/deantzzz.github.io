---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PostRow from '../components/PostRow.astro';
import orbitalCore from '../assets/orbital-core.png';
import deepSpace from '../assets/deep-space.png';
import { SITE } from '../config';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
---
<Base>
  <section class="hero" aria-labelledby="blog-title">
    <div class="hero-environment" aria-hidden="true"><Image src={deepSpace} alt="" widths={[800, 1500, 2048]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" /></div>
    <canvas class="light-field" aria-hidden="true"></canvas>
    <div class="pointer-light" aria-hidden="true"></div>
    <div class="hero-inner content">
      <div class="hero-copy">
        <h1 id="blog-title">{SITE.name}</h1>
        <p class="tagline">{SITE.tagline}</p>
        <p class="intro-description">{SITE.description}</p>
        <div class="hero-actions"><a class="primary-link" href="#articles">开始阅读 <Arrow /></a><a class="secondary-link" href="/about/">关于我</a></div>
      </div>
      <button class="core-stage" type="button" aria-label="触发轨道核心光波" title="点击或按回车，释放光波">
        <span class="core-parallax"><span class="core-float"><Image src={orbitalCore} alt="青紫光辉交织的悬浮轨道核心" widths={[440, 800, 1280]} sizes="(max-width: 700px) 95vw, 700px" format="webp" loading="eager" fetchpriority="high" class="core-art" /></span></span>
        <span class="core-halo" aria-hidden="true"></span>
        <span class="core-pulse" aria-hidden="true"></span>
      </button>
    </div>
  </section>
  <div class="light-controls content" aria-label="光场设置">
    <span class="controls-label">光场</span>
    <div class="palette-controls" role="group" aria-label="光场配色"><button class="palette-button" data-palette-choice="aurora" type="button" aria-pressed="true"><span class="color-dot aurora-dot" aria-hidden="true"></span>极光</button><button class="palette-button" data-palette-choice="ember" type="button" aria-pressed="false"><span class="color-dot ember-dot" aria-hidden="true"></span>余烬</button></div>
    <button class="motion-toggle" type="button" aria-pressed="false"><span class="pause-symbol" aria-hidden="true"></span><span class="motion-label">暂停动效</span></button>
    <span class="pointer-hint"><svg width="18" height="26" viewBox="0 0 18 26" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="2" y="1" width="14" height="24" rx="7" /><path d="M9 5v5" /></svg><span>移动指针，唤醒光场</span></span>
    <span class="sr-only light-status" role="status" aria-live="polite"></span>
  </div>
  <section id="articles" class="latest content" aria-labelledby="latest-title">
    <div class="section-heading" data-reveal>
      <h2 id="latest-title">最新文章</h2>
      <a class="text-link" href="/archive/">全部归档 <Arrow /></a>
    </div>
    {posts.slice(0, 5).map((post) => <PostRow post={post} />)}
    {posts.length === 0 && <p class="empty-state">第一篇文章，正在路上。</p>}
  </section>
</Base>
