---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import PostRow from '../components/PostRow.astro';
import foldedTitanium from '../assets/folded-titanium.png';
import { getPublishedPosts } from '../lib/posts';
const posts = await getPublishedPosts();
---
<Base>
  <div class="home-grid content">
    <section id="articles" class="latest" aria-labelledby="latest-title">
      <div class="section-heading">
        <h1 id="latest-title">最新文章</h1>
        <a class="text-link" href="/archive/">全部归档 <Arrow /></a>
      </div>
      {posts.slice(0, 5).map((post) => <PostRow post={post} heading="h2" />)}
      {posts.length === 0 && <p class="empty-state">暂无文章。</p>}
    </section>
    <div class="home-art" aria-hidden="true">
      <Image src={foldedTitanium} alt="" widths={[320, 600]} sizes="(max-width: 1100px) 220px, 260px" format="webp" loading="eager" />
    </div>
  </div>
</Base>
